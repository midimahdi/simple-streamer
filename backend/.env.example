# ==============================================================================
# Mosque Dual-Stream Orchestrator - Environment Variables
# ==============================================================================

# Server Port (Cloud Run / Local)
PORT=8080

# YouTube Data API v3 Credentials
# 1. Google Cloud Console -> APIs & Services -> OAuth consent screen -> Move to "In Production"
# 2. APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application or Desktop)
# 3. Use scripts/bootstrap-auth.mjs to mint offline refresh_token
YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-google-client-secret
YOUTUBE_REFRESH_TOKEN=1//your-offline-refresh-token
# Permanent liveStream ID created once in YouTube Studio or via bootstrap script
YOUTUBE_STREAM_ID=your-permanent-stream-id
# Stream Privacy: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public

# Meta / Facebook Live API Credentials
# 1. Meta Business Suite -> System Users -> Admin System User (Token expiration: Never)
# 2. Permissions: pages_manage_posts, pages_read_engagement, publish_video
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_ACCESS_TOKEN=your-never-expiring-system-user-or-page-token

# Mosque Brand & Description Defaults
MOSQUE_NAME="Masjid Al-Noor"
MOSQUE_FACEBOOK_URL="https://facebook.com/your-page"
MOSQUE_YOUTUBE_URL="https://youtube.com/@your-channel"
MOSQUE_DONATION_URL="https://your-mosque-donation-link.org"

# Security (Optional shared secret between Dock and Backend)
ORCHESTRATOR_API_KEY=""
