@echo off
setlocal EnableDelayedExpansion
title Simple Streamer Setup for OBS Studio

echo =======================================================
echo          SIMPLE STREAMER - SETUP WIZARD
echo =======================================================
echo.

:: 1. Check if OBS Studio is running and ask to close
tasklist /FI "IMAGENAME eq obs64.exe" 2>NUL | find /I /N "obs64.exe">NUL
if "%ERRORLEVEL%"=="0" (
    echo [!] OBS Studio is currently running.
    echo     Please save your work and close OBS Studio before proceeding.
    echo.
    set /p OBS_CHOICE="Do you want this setup to close OBS Studio for you? (Y/N): "
    if /I "!OBS_CHOICE!"=="Y" (
        echo Closing OBS Studio...
        taskkill /F /IM obs64.exe /T >nul 2>&1
        timeout /t 2 /nobreak >nul
    ) else (
        echo Please close OBS Studio and re-run this setup.
        pause
        exit /b 1
    )
)

:: 2. Check if install.ps1 exists next to bat, otherwise extract embedded payload
set "SCRIPT_DIR=%~dp0"
set "PS_SCRIPT=%SCRIPT_DIR%install.ps1"
set "TEMP_PS="

if not exist "%PS_SCRIPT%" (
    set "PS_SCRIPT=%TEMP%\SimpleStreamer_install_%RANDOM%.ps1"
    set "TEMP_PS=1"
    powershell.exe -NoProfile -Command "[System.IO.File]::WriteAllBytes('%TEMP%\SimpleStreamer_install.ps1', [System.Convert]::FromBase64String(''))"
    set "PS_SCRIPT=%TEMP%\SimpleStreamer_install.ps1"
)

echo [*] Installing Simple Streamer Dock and WebSocket configuration...
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%PS_SCRIPT%"
set "EXIT_CODE=%ERRORLEVEL%"

if defined TEMP_PS (
    del /f /q "%PS_SCRIPT%" 2>nul
)

if "%EXIT_CODE%"=="0" (
    echo.
    echo =======================================================
    echo   [SUCCESS] Simple Streamer setup completed!
    echo   You can now launch OBS Studio. Look for the
    echo   'Simple Streamer' dock under Docks in the top menu.
    echo =======================================================
) else (
    echo.
    echo [ERROR] Setup encountered an issue (Code: %EXIT_CODE%).
)

pause
